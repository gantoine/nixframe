<?xml version="1.0" encoding="utf-8"?>
<!-- One forecast row: day · icon · low ━━ range bar ━━ high. Rows share the panel height (weight 1). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/day_name"
        style="@style/WeatherText"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:textSize="22sp" />

    <ImageView
        android:id="@+id/day_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/weather" />

    <TextView
        android:id="@+id/day_low"
        style="@style/WeatherTextSecondary"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="#99EAEBEE"
        android:textSize="22sp" />

    <nl.giejay.android.tv.immich.weather.TempRangeBar
        android:id="@+id/day_bar"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/day_high"
        style="@style/WeatherText"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:textSize="22sp" />
</LinearLayout>
