<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Lollipop fallback (KitKat frames): <ripple> and color-state-list shape fills are API 21+,
     see drawable-v21. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/action_button_corner_radius" />
            <solid android:color="@color/action_button_background_focused_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/action_button_corner_radius" />
            <solid android:color="@color/action_button_background_unfocused_color" />
        </shape>
    </item>
</selector>
