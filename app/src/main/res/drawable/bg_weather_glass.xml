<?xml version="1.0" encoding="utf-8"?>
<!-- Smoked-glass panel for the weather page: a dark translucent fill (keeps white text legible over
     bright clouds) with a faint light hairline edge. No real blur — too costly on the frame's GPU. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2E0A1420" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
    <corners android:radius="22dp" />
</shape>
