<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted Glass panel, matching the Home tab and the HA theme: a near-transparent fill over the
     blurred wallpaper, lighter at the top, with a hairline rgba(234,235,238,.22) edge and an 18dp
     radius. Same values as FrostedWallpaper's GLASS_TOP / GLASS_BOTTOM / EDGE. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#26FFFFFF"
        android:endColor="#12FFFFFF" />
    <stroke
        android:width="1px"
        android:color="#38EAEBEE" />
    <corners android:radius="18dp" />
</shape>
