<!-- Signed in, the app is one ambient screen (photos, glance, doorbell, what to show, settings);
     sign-in is the only other place. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/ambientFragment"
    tools:ignore="UnusedNavigation">

    <action
        android:id="@+id/action_global_signInFragment"
        app:destination="@id/authFragment" />

    <action
        android:id="@+id/action_global_ambientFragment"
        app:destination="@id/ambientFragment" />

    <fragment
        android:id="@+id/ambientFragment"
        android:name="nl.giejay.android.tv.immich.ambient.AmbientFragment"
        android:label="Ambient" />

    <fragment
        android:id="@+id/authFragment"
        android:name="nl.giejay.android.tv.immich.auth.AuthFragmentStep1"
        android:label="Authentication">
        <action
            android:id="@+id/action_auth_to_auth_2"
            app:destination="@id/authFragmentStep2" />
    </fragment>

    <fragment
        android:id="@+id/authFragmentStep2"
        android:name="nl.giejay.android.tv.immich.auth.AuthFragmentStep2"
        android:label="Authentication" />
</navigation>
