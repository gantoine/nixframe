<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keep the display awake while showing photos (Nixplay frame) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Auto-dim after sunset (display.DisplayController): set the backlight level and draw a
         dimming overlay below the backlight's floor. Granted at install on KitKat / system apps. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Access internet-based media -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>

    <!-- Touch screen is not required -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- This is an Android TV app only (not intended for mobile) -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <application
        android:name="nl.giejay.android.tv.immich.ImmichApplication"
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@drawable/icon"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:banner="@mipmap/icon_banner_v2"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Runs before Application.onCreate() and before any other provider with a lower
             initOrder (FirebaseInitProvider is at 100, this is set higher so it always wins). -->
        <provider
            android:name="nl.giejay.android.tv.immich.AppContextInitializer"
            android:authorities="${applicationId}.appcontextinitializer"
            android:exported="false"
            android:initOrder="2147483647" />

        <!-- Lets the remote's power button switch the display off at once (sensors.ScreenOffAdmin). -->
        <receiver
            android:name=".sensors.ScreenOffAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/screen_off_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation">

            <!-- Used as the main entry point from the leanback launcher.
                 HOME + DEFAULT categories let the app act as the device's home/launcher
                 app so the Nixplay frame can boot straight into it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

    </application>

</manifest>